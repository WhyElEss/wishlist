# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Read with `format: raw`: write values as-is, without quotes.

# Host port for the web UI (LAN). Compose substitutes it, so it may stay unset.
HOST_PORT=8095
TZ=America/Toronto

# Admin password hash (required). Generate it with:
#   docker compose run --rm -it wishlist hashpw
ADMIN_PASSWORD_HASH=

# Public origin, without a trailing slash. Needed for links in e-mails and
# accepted as Origin of form posts. Leave empty while testing on the LAN.
BASE_URL=

# Read client IP and country from Cloudflare headers (CF-Connecting-IP,
# CF-IPCountry). Country only picks the default shipping address for items
# whose region is "auto".
TRUST_PROXY_HEADERS=true

# E-mail for guests (optional): reservation link and a reminder 3 days before
# expiry. SMTP with STARTTLS (port 587). Needs BASE_URL. Without SMTP_HOST the
# e-mail field is hidden from guests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Where the owner's notices about reservations, purchases and cancellations
# go. Empty means the SMTP_FROM address.
NOTIFY_EMAIL=
